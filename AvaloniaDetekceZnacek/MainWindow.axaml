<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaDetekceZnacek.MainWindow"
        Title="AvaloniaDetekceZnacek">


    <TabControl Margin="16">
        <TabItem Header="Detekce">
            <Grid RowDefinitions="Auto, *, Auto" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,190,*" ColumnSpacing="16">
                    <Button x:Name="OpenButton" Grid.Column="0" Content="Nahrát obrázek" Click="OpenButton_Click" />
                    <TextBlock x:Name="StageLabel" Grid.Column="1" VerticalAlignment="Center" />

                    <Slider x:Name="StageSlider" Grid.Column="2" Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="False" VerticalAlignment="Center" ValueChanged="StageSlider_ValueChanged" />

                </Grid>
                <Image x:Name="ResultImage" Grid.Row="1" Stretch="Uniform" />
                <ScrollViewer Grid.Row="2" Height="150" HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CropPanel" Orientation="Horizontal" Spacing="10" />
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Header="Klasifikace">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ClassificationPanel" Spacing="10" />
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
