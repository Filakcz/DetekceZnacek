<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaDetekceZnacek.MainWindow"
        Title="AvaloniaDetekceZnacek">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Margin="8" Content="Otevřít obrázek…" Click="OpenButton_Click" />
        </StackPanel>
        <Border Background="#202020" Margin="4">
            <Image x:Name="ResultImage" Stretch="Uniform" />
        </Border>
    </DockPanel>
</Window>
